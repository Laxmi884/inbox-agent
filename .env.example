# Copy to .env and edit:  cp .env.example .env
# .env is gitignored; this file is the committed template.
# Every value here is optional — with no .env at all the notebook runs offline.

# ---------------------------------------------------------------------------
# Backend selection
# ---------------------------------------------------------------------------
# ollama | openrouter | openai | offline
# Leave unset to auto-detect: openrouter -> openai -> ollama -> offline.
# Pin to "ollama" while iterating on prompts (free, private, no rate limits).
CAB_LLM_BACKEND=ollama

# ---------------------------------------------------------------------------
# Local inference (Ollama)
# ---------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
# gemma4:12b   - 7.6 GB, default: faster, tighter report prose
# qwen3:14b    - 9.3 GB, stronger generalist for multi-step agentic loops
OLLAMA_MODEL=gemma4:12b

# ---------------------------------------------------------------------------
# Hosted inference — fill in when moving off local
# ---------------------------------------------------------------------------
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# The CAB week to report on
# ---------------------------------------------------------------------------
CAB_DATE=2026-08-20
# ---------------------------------------------------------------------------
# Inbox Agent — LangSmith (tracing + Context Hub policy versioning)
# Get a key at https://smith.langchain.com/settings  (starts with lsv2_pt_)
# ---------------------------------------------------------------------------
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=inbox-agent

# Context Hub repo holding the versioned agent policy (prompts, taxonomy, rules
# of engagement). Pull a specific tag to pin a run: inbox-triage:prod
# Blank = latest. "dev" is not a ref the hub can resolve and hid a
# misconfiguration for weeks - see config.py's comment on context_hub_tag.
CONTEXT_HUB_SKILL=inbox-triage
CONTEXT_HUB_TAG=

# ---------------------------------------------------------------------------
# Inbox Agent — behaviour
# ---------------------------------------------------------------------------
# Backend for the inbox agent. Same resolver as CAB: ollama|openrouter|openai|offline
INBOX_LLM_BACKEND=ollama

# Nothing touches Gmail while this is true. Flip deliberately.
INBOX_DRY_RUN=true

# Frozen evaluation set: how many recent inbox threads to snapshot.
INBOX_SNAPSHOT_SIZE=50
INBOX_SNAPSHOT_DIR=inbox_agent/snapshot

# Append-only audit log of every action the agent takes or proposes.
INBOX_AUDIT_LOG=inbox_agent/audit.jsonl

# Actions the agent may NEVER take, comma separated. send_message is
# non-negotiable per design; trash requires an explicit learned rule or
# a human approval at the interrupt.
INBOX_FORBIDDEN_ACTIONS=send_message,delete_forever

# auto | ollama | none. Whether rule text is embedded for semantic search.
# auto indexes when Ollama is running and degrades to none (exact match only)
# when it is not. ollama pins the requirement and fails loudly instead of
# degrading - use it only when the index must exist. `inbox-agent doctor`
# reports the mode this actually resolved to, not just what is configured.
INBOX_EMBEDDINGS=auto
# ---------------------------------------------------------------------------
# Jira (CAB notebook). Create a token at id.atlassian.com -> API tokens.
# ---------------------------------------------------------------------------
JIRA_DOMAIN=your-site.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=ATATT...

# A needs_reply / important_fyi older than this stops being held in the inbox.
# Deterministic, applied after classification. See inbox_agent/recency.py.
INBOX_STALE_AFTER_DAYS=90
# --- Telegram review UI -----------------------------------------------------
# Token from @BotFather. A live credential: never commit it.
INBOX_TG_TOKEN=
# The ONE Telegram user id allowed to drive the bot. Updates from any other id
# are dropped and logged. Without this the bot is open to anyone who finds it.
INBOX_TG_CHAT_ID=
# digest | paged
INBOX_TG_MODE=digest

# --- Live Gmail --------------------------------------------------------------
# snapshot | live. The one switch that decides whether a real mailbox is on the
# other end. Defaults to snapshot, so an unconfigured checkout and the whole
# test suite behave exactly as they always have. An unrecognised value is
# refused at load time rather than falling back - answering a request for the
# real mailbox with the snapshot would be a run that looks fine and did nothing.
INBOX_GMAIL=snapshot

# OAuth client of type "Desktop app", downloaded from the Google Cloud Console.
# Enable the Gmail API, then Google Auth Platform -> Clients -> Create Client.
#
# Publishing status matters: an External app left in "Testing" has its refresh
# token revoked by Google after exactly seven days, which surfaces a week later
# as an unexplained re-auth prompt. Publishing needs an app name, support email,
# homepage URL and privacy policy URL. Until those exist, add yourself under
# Audience -> Test users and accept the weekly re-auth.
INBOX_GOOGLE_CREDENTIALS=secrets/credentials.json

# Written by the consent flow on first run, at mode 600. Holds the refresh
# token, which is what lets the scheduled digest authenticate with nobody
# present. A live credential: never commit it. secrets/ is gitignored.
INBOX_GOOGLE_TOKEN=secrets/token.json

# Characters of message body allowed into the classifier prompt.
# 0 = snippet only, which is what the snapshot has always given (its bodies are
# empty). Bodies are still fetched and stored at 0 - this governs only what
# reaches the model, so the snippet-vs-body comparison is a config flip rather
# than a re-fetch. Note the prompt separately truncates at MAX_BODY_CHARS=4000.
INBOX_BODY_BUDGET=0

# Rotating operational log (5MB x 5). Empty logs to stderr, which is right
# interactively and wrong under launchd - nothing rotates a StandardErrorPath.
INBOX_LOG_FILE=
