# Copy to .env and edit:  cp .env.example .env
# .env is gitignored; this file is the committed template.
# Every value here is optional — with no .env at all the notebook runs offline.

# ---------------------------------------------------------------------------
# Backend selection
# ---------------------------------------------------------------------------
# ollama | openrouter | openai | offline
# Leave unset to auto-detect: openrouter -> openai -> ollama -> offline.
# Pin to "ollama" while iterating on prompts (free, private, no rate limits).
CAB_LLM_BACKEND=ollama

# ---------------------------------------------------------------------------
# Local inference (Ollama)
# ---------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
# gemma4:12b   - 7.6 GB, default: faster, tighter report prose
# qwen3:14b    - 9.3 GB, stronger generalist for multi-step agentic loops
OLLAMA_MODEL=gemma4:12b

# ---------------------------------------------------------------------------
# Hosted inference — fill in when moving off local
# ---------------------------------------------------------------------------
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# The CAB week to report on
# ---------------------------------------------------------------------------
CAB_DATE=2026-08-20
# ---------------------------------------------------------------------------
# Inbox Agent — LangSmith (tracing + Context Hub policy versioning)
# Get a key at https://smith.langchain.com/settings  (starts with lsv2_pt_)
# ---------------------------------------------------------------------------
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=inbox-agent

# Context Hub repo holding the versioned agent policy (prompts, taxonomy, rules
# of engagement). Pull a specific tag to pin a run: inbox-triage:prod
CONTEXT_HUB_SKILL=inbox-triage
CONTEXT_HUB_TAG=dev

# ---------------------------------------------------------------------------
# Inbox Agent — behaviour
# ---------------------------------------------------------------------------
# Backend for the inbox agent. Same resolver as CAB: ollama|openrouter|openai|offline
INBOX_LLM_BACKEND=ollama

# Nothing touches Gmail while this is true. Flip deliberately.
INBOX_DRY_RUN=true

# Frozen evaluation set: how many recent inbox threads to snapshot.
INBOX_SNAPSHOT_SIZE=50
INBOX_SNAPSHOT_DIR=inbox_agent/snapshot

# Append-only audit log of every action the agent takes or proposes.
INBOX_AUDIT_LOG=inbox_agent/audit.jsonl

# Actions the agent may NEVER take, comma separated. send_message is
# non-negotiable per design; trash requires an explicit learned rule or
# a human approval at the interrupt.
INBOX_FORBIDDEN_ACTIONS=send_message,delete_forever
