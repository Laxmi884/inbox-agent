# Secrets — never commit. Commit .env.example instead.
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Jupyter
.ipynb_checkpoints/

# Tooling
.code-review-graph/
.DS_Store

# Inbox agent — real email on disk, never commit
inbox_agent/snapshot/
inbox_agent/store/
*.jsonl

# Google OAuth: the client secret and the refresh token it produces. Both are
# live credentials for the real mailbox. Ignored BEFORE either file exists, on
# purpose — df1f2da put a bot token in this repo's history exactly once.
secrets/

# LangGraph checkpoints hold graph state, which includes full thread content.
# Real email - never commit.
inbox_agent/checkpoints.sqlite*
*.sqlite
*.sqlite-shm
*.sqlite-wal
.superpowers/

# Scratch notebooks — test.ipynb held a live Cohere API key in cell source.
# Untracked files are invisible to tools/secret_scan.py (it reads git ls-files
# and the staged set), so an untracked scratch file is exactly where a secret
# survives unnoticed until someone runs `git add .`.
test.ipynb
parsed_output.md

# Worktrees created for parallel branches. These are full checkouts managed by
# git itself; committing them would nest the repo inside itself.
.claude/worktrees/

# Per-developer Claude Code config: permission allow/deny rules and which MCP
# servers that person has enabled. Machine-specific, not a team decision, and
# publishing one operator's permission grants as if they were the project's is
# how a guard rail gets inherited by someone who never chose it.
# .claude/settings.json IS tracked on purpose - it carries the pre-commit
# guard hook, which every clone should get.
.claude/settings.local.json

# Manual verification runs write these; they carry banner output (paths,
# chat id, the resolved policy commit) that has no business in the repo.
.manual-test-*
